{
  "name": "mapa-operacional-amazonas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema de Comando e Controle para operações do CBMAM",
  "author": "Allan2fish",
  "license": "MIT",
  "homepage": "https://github.com/Allan2fish/mapa-operacional-amazonas#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Allan2fish/mapa-operacional-amazonas.git"
  },
  "bugs": {
    "url": "https://github.com/Allan2fish/mapa-operacional-amazonas/issues"
  },
  "keywords": [
    "cbmam",
    "bombeiros",
    "amazonas",
    "mapa-operacional",
    "react",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .jsx,.js",
    "lint:fix": "eslint src --ext .jsx,.js --fix",
    "format": "prettier --write \"src/**/*.{jsx,js,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{jsx,js,json,css,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit --allowJs --checkJs src/main.jsx",
    "prepare": "husky",
    "docker:build": "docker build -t mapa-operacional-amazonas .",
    "docker:run": "docker run -p 8080:80 mapa-operacional-amazonas"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{jsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
